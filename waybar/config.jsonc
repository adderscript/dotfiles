// -*- mode: jsonc -*-
{
    "layer": "top",
    "position": "top",
    "height": 16,
    "spacing": 0,
    "margin": "3px 3px 0px 3px",
    "exclusive": false,
    "passthrough": true,
    "reload_on_style_change": true,

    // Choose the order of the modules
    "modules-left": [
        "niri/workspaces",
    ],
    "modules-center": [
        "mpris",
    ],
    "modules-right": [
        "network",
        "battery",
        "clock",
    ],

    "niri/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "1": "I",
            "2": "II",
            "3": "III",
            "4": "IV",
            "5": "V",
            "6": "VI",
            "7": "VII",
            "8": "VIII",
            "9": "IX",
            "10": "X"
        }
    },
    "mpris": {
        "format": "<span foreground='#bb7643'>{player_icon}</span>  {title}",
        "max-length": 40,

        "player-icons": {
            "default": "",
            "spotify": "",
            "firefox": "",
            "vlc": "󰕼"
        }
    },
    "clock": {
        "format": "<span foreground='#bb7643'></span> {:%H:%M} "
    },
    "battery": {
        "interval": 60,
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "<span foreground='#bb7643'>{icon}</span> {capacity}%  ",
        "format-full": "<span foreground='#bb7643'>{icon}</span> {capacity}%  ",
        "format-charging": "<span foreground='#bb7643'></span> {capacity}%  ",
        "format-plugged": "<span foreground='#bb7643'></span>  ",
        "format-alt": "<span foreground='#bb7643'>{icon}</span> {time}  ",
        "tooltip-format": "{timeTo}\n\n󰠠  Usage: {power:0.1f}W\n󱤅  Condition: {health}%\n󱍸  Total: {cycles} cycles  ",
        "format-icons": {
            "default": [
                "󰂎",
                "󰁺",
                "󰁻",
                "󰁼",
                "󰁽",
                "󰁾",
                "󰁿",
                "󰂀",
                "󰂁",
                "󰂂",
                "󰁹"
            ]
        }
    },
    "network": {
        "max-length": 9,
        "format": "<span foreground='#bb7643'></span>  up  ",
        "format-disconnected": "  Down  "
    },
}
