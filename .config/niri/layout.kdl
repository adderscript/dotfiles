hotkey-overlay {
    skip-at-startup
}

prefer-no-csd

layout {
    gaps 8
    center-focused-column "never"
    background-color "#660000"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        off
    }

    border {
        on

        width 1.5
        active-color "#a7c080"
        inactive-color "#444b6a"
        urgent-color "#9b0000"
    }

    shadow {
        off
        softness 10
        spread 3
        offset x=0 y=2
        color "#00000077"
    }
}

overview {
    backdrop-color "#2b3339"
}

blur {
    offset 2.0
    passes 2
}

