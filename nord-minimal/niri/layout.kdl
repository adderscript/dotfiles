prefer-no-csd

layout {
    gaps 10
    background-color "#191724"

    focus-ring {
        on
        width 1.25

        active-color "#7a808c"
        inactive-color "#191724"
        urgent-color   "#ffb4ab"
    }

    border {
        off
        width 2

        active-color "#9692b2"
        inactive-color "#191724"
        urgent-color   "#ffb4ab"
    }

    shadow {
        on
        softness 4
        spread 1
        offset x=0 y=0
        draw-behind-window false
        color "#000000d0"
        // inactive-color "#00000054"
    }
    
    tab-indicator {
        active-color   "#f1be6d"
        inactive-color "#18130b"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#f1be6d80"
    }
}

overview {
    backdrop-color "#181825"
}
